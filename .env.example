# NutriShield canonical runtime. Copy to /etc/nutrishield/nutrishield.env on VPS.
# Never commit real values.

NUTRISHIELD_DB_PATH=/opt/nutrishield/current/web-nutrishield/database/runtime/nutrishield.sqlite3
SESSION_COOKIE_NAME=nutrishield_session
SESSION_HOURS=168
COOKIE_SECURE=1
ALLOWED_ORIGINS=https://nutrishield.web.id

# OpenAI-compatible LLM endpoint. OPENAI_* is preferred.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-rotated-key
OPENAI_MODEL=gpt-5-mini

# Existing 9Router installations may use these aliases instead.
# ROUTER_BASE_URL=http://127.0.0.1:27888/api/v1/chat/completions
# ROUTER_API_KEY=replace-with-rotated-key
# DEFAULT_MODEL=qwen-max

# Telegram webhook integration.
TELEGRAM_BOT_TOKEN=replace-with-new-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-32-plus-character-secret
TELEGRAM_BOT_USERNAME=NutriShieldAIBot

FRONTEND_DIST=/opt/nutrishield/current/web-nutrishield/frontend/dist
WORKER_POLL_SECONDS=0.5
AGENT_WORKER_MODE=external
MAX_REQUEST_BYTES=2097152
