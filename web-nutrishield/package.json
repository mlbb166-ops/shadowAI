{
  "name": "nutrishield-monorepo",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "python3 -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8080 --reload",
    "build": "npm run build --workspace=frontend",
    "test": "python3 -m pytest -q backend/tests && npm run build --workspace=frontend",
    "db:init": "python3 backend/scripts/init_db.py --db database/runtime/nutrishield.sqlite3",
    "db:import": "python3 backend/scripts/import_food_data.py --db database/runtime/nutrishield.sqlite3 --report database/runtime/food-import-report.json",
    "agent:worker": "python3 -m agents.worker",
    "smoke": "python3 backend/scripts/e2e_smoke.py"
  }
}
